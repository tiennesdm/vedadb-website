pageType: chapter
background:
  type: solid
  color: "$primary"
elements:
  - elementId: chapter-number
    elementType: text
    bounds: [60, 120, 200, 156]
    content:
      style: "$chapterNumber"
      align: [left, top]
      wrap: false
      text: |
        <p>01</p>
  - elementId: accent-line
    elementType: shape
    bounds: [60, 370, 80, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: chapter-title
    elementType: text
    bounds: [60, 390, 800, 52]
    content:
      style: "$chapterTitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>THE PROBLEM</p>
  - elementId: chapter-subtitle
    elementType: text
    bounds: [60, 460, 1000, 30]
    content:
      fontSize: 20
      color: "$light"
      fontFamily: "QuattrocentoSans"
      align: [left, middle]
      wrap: false
      text: |
        <p>Modern applications need 7+ databases — creating complexity, cost, and chaos</p>