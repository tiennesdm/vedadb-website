pageType: content
background:
  type: solid
  color: "$background"
elements:
  # Common: VEDADB logotype
  - elementId: logotype
    elementType: text
    bounds: [60, 20, 100, 20]
    content:
      text: VEDADB
      fontSize: 12
      fontFamily: Liter
      color: "$accent"
      wrap: false

  # Common: Page number
  - elementId: page-num
    elementType: text
    bounds: [1196, 685, 40, 20]
    content:
      text: "06"
      fontSize: 13
      color: "$secondary"
      wrap: false
      align: [right, middle]

  # Common: Gold accent line
  - elementId: accent-line
    elementType: shape
    bounds: [60, 690, 40, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # Title
  - elementId: title
    elementType: text
    bounds: [60, 55, 1160, 44]
    content:
      style: "$title"
      fontSize: 28
      wrap: false
      text: |
        <p>VedaDB: One Engine. Seven Data Models.</p>

  # --- 7 Model Cards (Row 1) ---
  # Card backgrounds
