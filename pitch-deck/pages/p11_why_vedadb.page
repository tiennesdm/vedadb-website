pageType: content
background:
  type: solid
  color: "$background"
elements:
  # Common: VEDADB logotype
  - elementId: logotype
    elementType: text
    bounds: [60, 20, 100, 20]
    content:
      text: VEDADB
      fontSize: 12
      fontFamily: Liter
      color: "$accent"
      wrap: false

  # Common: Page number
  - elementId: page-num
    elementType: text
    bounds: [1196, 685, 40, 20]
    content:
      text: "11"
      fontSize: 13
      color: "$secondary"
      wrap: false
      align: [right, middle]

  # Common: Gold accent line
  - elementId: accent-line
    elementType: shape
    bounds: [60, 690, 40, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # Title
  - elementId: title
    elementType: text
    bounds: [60, 50, 1160, 44]
    content:
      style: "$title"
      fontSize: 28
      wrap: false
      text: |
        <p>Why VedaDB Wins: The Only Truly Unified Architecture</p>

  # ===== LEFT COLUMN (4 items) =====
  # Item 1: One Engine
  - elementId: left-icon-1
    elementType: icon
    bounds: [60, 115, 24, 24]
    iconName: "fas:code"
    fill:
      type: solid
      color: "$accent"
  - elementId: left-title-1
    elementType: text
    bounds: [96, 112, 524, 30]
    content:
      text: |
        <p><strong>One Engine Replaces 7 DBs</strong></p>
      fontSize: 20
      fontFamily: QuattrocentoSans
      color: "$primary"
      wrap: false
  - elementId: left-desc-1
    elementType: text
    bounds: [96, 145, 524, 48]
    content:
      text: |
        <p>PostgreSQL, Pinecone, Neo4j, MongoDB, Redis, Elastic, InfluxDB</p>
      fontSize: 16
      fontFamily: QuattrocentoSans
      color: "$text"
      lineHeight: 1.3

  # Item 2: Zero ETL
  - elementId: left-icon-2
    elementType: icon
    bounds: [60, 215, 24, 24]
    iconName: "fas:link"
    fill:
      type: solid
      color: "$accent"
  - elementId: left-title-2
    elementType: text
    bounds: [96, 212, 524, 30]
    content:
      text: |
        <p><strong>Zero ETL</strong></p>
      fontSize: 20
      fontFamily: QuattrocentoSans
      color: "$primary"
      wrap: false
  - elementId: left-desc-2
    elementType: text
    bounds: [96, 245, 524, 48]
    content:
      text: |
        <p>Same data as SQL, Vector, Graph, Document — no replication</p>
      fontSize: 16
      fontFamily: QuattrocentoSans
      color: "$text"
      lineHeight: 1.3

  # Item 3: 8 Language Drivers
  - elementId: left-icon-3
