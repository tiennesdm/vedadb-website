pageType: content
background:
  type: solid
  color: "$background"
elements:
  # Common: VEDADB logotype
  - elementId: logotype
    elementType: text
    bounds: [60, 20, 100, 20]
    content:
      text: VEDADB
      fontSize: 12
      fontFamily: Liter
      color: "$accent"
      wrap: false

  # Common: Page number
  - elementId: page-num
    elementType: text
    bounds: [1196, 685, 40, 20]
    content:
      text: "04"
      fontSize: 13
      color: "$secondary"
      wrap: false
      align: [right, middle]

  # Common: Gold accent line
  - elementId: accent-line
    elementType: shape
    bounds: [60, 690, 40, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # Title
  - elementId: title
    elementType: text
    bounds: [60, 55, 1160, 44]
    content:
      style: "$title"
      fontSize: 28
      wrap: false
      text: |
        <p>Engineering Teams Run 7+ Databases Per App — It's Unsustainable</p>

  # Left bullets
  - elementId: bullets
    elementType: text
    bounds: [60, 120, 640, 310]
    content:
      fontSize: 18
      fontFamily: QuattrocentoSans
      color: "$text"
      lineHeight: 1.5
      text: |
        <ul>
        <li><strong>68%</strong> of enterprises run 10+ separate databases (up from 23% in 2020)</li>
        <li>Each DB needs: separate query language, driver, monitoring, backup system</li>
        <li>Engineers spend <strong>40%+</strong> time managing infrastructure vs. building products</li>
        <li>Same data copied across PostgreSQL, Neo4j, MongoDB, Redis, Elasticsearch, InfluxDB, Pinecone</li>
        <li>Costs multiply: licensing + hosting + personnel for each database</li>
        </ul>

  # Right side: DB labels and chaos diagram
